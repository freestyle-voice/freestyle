{
  "name": "@freestyle-voice/electron",
  "productName": "Freestyle",
  "desktopName": "freestyle.desktop",
  "version": "0.7.1",
  "description": "Voice-to-text that works everywhere",
  "author": "freestyle-voice",
  "homepage": "https://github.com/freestyle-voice/freestyle",
  "main": "./out/main/index.js",
  "scripts": {
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "compile:native": "node scripts/compile-native.js",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "analyze": "ANALYZE=1 electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run compile:native && electron-vite build && electron-builder --win --publish never",
    "build:mac": "npm run compile:native && electron-vite build && electron-builder --mac --publish never",
    "generate:linux-icons": "python3 scripts/generate-linux-icons.py",
    "build:linux": "npm run compile:native && electron-vite build && electron-builder --linux --publish never",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@ai-sdk/react": "^3.0.44",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@freestyle-voice/server": "workspace:*",
    "@freestyle-voice/utils": "workspace:*",
    "@freestyle-voice/validations": "workspace:*",
    "@tanstack/react-query": "^5.101.2",
    "ai": "^6.0.191",
    "diff": "^8.0.4",
    "electron-updater": "^6.3.9",
    "freestyle-voice": "workspace:*",
    "hono": "^4.12.22",
    "react-markdown": "^9.1.0",
    "remark-gfm": "^4.0.0",
    "shiki": "^3.23.0"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "rollup-plugin-visualizer": "^6.0.4",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^4.1.7"
  }
}
