{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "rules": {
    // Export cleanup is a larger existing backlog. Keep the initial CI gate
    // focused on unused files, dependencies, unresolved imports, and binaries.
    "exports": "off",
    "types": "off",
    "enumMembers": "off",
    "namespaceMembers": "off"
  },
  "ignoreBinaries": ["pactl", "pkg-config", "powershell.exe", "python3"],
  "ignoreFiles": [
    "apps/electron/src/preload/*.d.ts",
    "apps/electron/src/renderer/src/env.d.ts",
    "plugins/*/ui/vite-env.d.ts",
    // Templates are standalone starter projects downloaded by create-freestyle-plugin,
    // not workspace code. They are never imported or built within the monorepo.
    "templates/**"
  ],
  "workspaces": {
    "apps/electron": {
      "entry": [
        "electron.vite.config.ts",
        "src/main/index.ts",
        "src/preload/index.ts",
        "src/renderer/src/components/panel.tsx",
        "src/renderer/src/components/companion.tsx",
        "tests/**/*.ts",
        "scripts/**/*.{js,mjs}"
      ],
      "project": [
        "src/**/*.{ts,tsx,d.ts,css}",
        "scripts/**/*.{js,mjs,ts}",
        "tests/**/*.ts",
        "*.config.ts"
      ],
      "paths": {
        "@renderer/*": ["src/renderer/src/*"],
        "@shared/*": ["src/shared/*"],
        "freestyle-voice": ["../../packages/sdk/src/index.ts"],
        "@freestyle-voice/server": ["../server/src/index.ts"],
        "@freestyle-voice/utils": ["../../packages/utils/src/index.ts"],
        "@freestyle-voice/validations": [
          "../../packages/validations/src/index.ts"
        ]
      },
      "ignoreDependencies": ["playwright"]
    },
    "apps/server": {
      "entry": ["src/startup.ts", "tests/**/*.test.ts"],
      "project": [
        "src/**/*.{ts,tsx}",
        "scripts/**/*.ts",
        "tests/**/*.ts",
        "*.config.ts"
      ],
      "paths": {
        "freestyle-voice": ["../../packages/sdk/src/index.ts"],
        "@freestyle-voice/utils": ["../../packages/utils/src/index.ts"],
        "@freestyle-voice/validations": [
          "../../packages/validations/src/index.ts"
        ],
        "@freestyle-voice/stt": ["../../packages/stt/src/index.ts"]
      },
      "vitest": {
        "entry": ["tests/**/*.test.ts", "tests/setup.ts"]
      },
      "ignoreDependencies": ["@types/json-schema"]
    },
    "apps/mobile": {
      // expo-router uses file-based routing under src/app plus the config
      // plugin entry, so treat those as roots and scan all app source.
      "entry": ["src/app/**/*.{ts,tsx}", "app.json"],
      "project": ["src/**/*.{ts,tsx}"],
      "paths": {
        "@/*": ["./src/*"]
      },
      // knip's Expo plugin infers expo-updates from the app config even when
      // OTA updates aren't configured; it isn't a real dependency here.
      // @sentry/cli is invoked by Sentry's generated native Xcode build phase,
      // not imported from TypeScript sources.
      "ignoreDependencies": ["expo-updates", "@sentry/cli"]
    },
    "packages/create-freestyle-plugin": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "plugins/*": {
      "entry": ["src/index.ts", "ui/src/main.{ts,tsx}"],
      "project": [
        "src/**/*.{ts,tsx}",
        "ui/src/**/*.{ts,tsx,css}",
        "ui/vite-env.d.ts"
      ]
    }
  }
}
